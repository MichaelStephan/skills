    {
      "name": "Setup",
      "item": [
        {
          "name": "Protected resource metadata",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/.well-known/oauth-protected-resource/v1/mcp"
          }
        },
        {
          "name": "Authorization server metadata",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/.well-known/oauth-authorization-server"
          }
        },
        {
          "name": "Register the Postman client",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Client registered', () => pm.response.to.have.status(201));",
                  "const clientId = pm.response.json().client_id;",
                  "if (clientId) {",
                  "    pm.collectionVariables.set('client_id', clientId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/v1/oauth/register",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"client_name\": \"Postman\",\n  \"redirect_uris\": [\n    \"https://oauth.pstmn.io/v1/callback\",\n    \"https://oauth.pstmn.io/v1/browser-callback\"\n  ],\n  \"grant_types\": [\n    \"authorization_code\",\n    \"refresh_token\"\n  ],\n  \"response_types\": [\n    \"code\"\n  ],\n  \"token_endpoint_auth_method\": \"none\",\n  \"scope\": \"mcp:tools offline_access\"\n}"
            },
            "description": "Registers Postman as a public OAuth client (dynamic client registration) and saves `client_id`. Send it once, before you get a token."
          }
        }
      ]
    },
