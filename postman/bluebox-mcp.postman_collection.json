  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Drops empty-string tool arguments, so an unset variable such as {{entity_id}}",
          "// is left out of the call instead of failing the tool's input validation.",
          "if (pm.request.method === 'POST' && pm.request.body && pm.request.body.mode === 'raw') {",
          "    let body;",
          "    try {",
          "        body = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
          "    } catch (e) {",
          "        body = null;",
          "    }",
          "    const args = body && body.params && body.params.arguments;",
          "    if (args) {",
          "        Object.keys(args).forEach((k) => {",
          "            if (args[k] === '') {",
          "                delete args[k];",
          "            }",
          "        });",
          "        pm.request.body.update(JSON.stringify(body, null, 2));",
          "    }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Reads the JSON-RPC message from a JSON or an SSE (text/event-stream) response,",
          "// checks it for errors and saves IDs for the next requests.",
          "pm.test('HTTP status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
          "",
          "const contentType = pm.response.headers.get('Content-Type') || '';",
          "const text = pm.response.text();",
          "let msg = null;",
          "if (contentType.includes('text/event-stream')) {",
          "    const data = text.split(/\\r?\\n/).filter((l) => l.startsWith('data:'));",
          "    if (data.length) {",
          "        msg = JSON.parse(data[data.length - 1].slice(5));",
          "    }",
          "} else if (contentType.includes('application/json') && text) {",
          "    msg = JSON.parse(text);",
          "}",
          "",
          "if (msg && msg.jsonrpc) {",
          "    pm.test('JSON-RPC call has no error', () => {",
          "        pm.expect(msg.error, JSON.stringify(msg.error)).to.be.undefined;",
          "    });",
          "    const result = msg.result || {};",
          "    if (result.isError) {",
          "        const reason = (result.content || []).map((c) => c.text).join(' ');",
          "        pm.test('Tool call succeeded', () => pm.expect.fail(reason));",
          "    }",
          "",
          "    const sc = result.structuredContent;",
          "    if (sc) {",
          "        // Keep IDs the user set; fill only the empty ones.",
          "        const fill = (name, value) => {",
          "            if (value && !pm.collectionVariables.get(name)) {",
          "                pm.collectionVariables.set(name, value);",
          "            }",
          "        };",
          "        const first = (sc.items || [])[0] || {};",
          "        fill('workspace_id', (sc.meta && sc.meta.default_workspace_id) || first.workspace_id);",
          "        fill('entity_id', first.entity_id);",
          "        fill('investigation_id', first.investigation_id);",
          "        fill('repository_id', first.repository_id);",
          "        if (sc.conversation_id) {",
          "            pm.collectionVariables.set('conversation_id', sc.conversation_id);",
          "        }",
          "        if (sc.status) {",
          "            console.log('ask status: ' + sc.status);",
          "        }",
          "    }",
          "}"
        ]
      }
    }
  ],
